#!/bin/bash
# RingOut.app's entry point (Contents/MacOS/RingOut). The app sits in the Ring Out
# folder beside game/, bin/ and userdata/, as the runtime does on Linux; this
# points the runtime at them, since its own directory is inside the bundle.
APP="$(cd "$(dirname "$0")/../.." && pwd -P)"
ROOT="$(dirname "$APP")"
MODULE="$ROOT/bin/gGRSEAF_recomp.dylib"

# No module means Setup has not run here -- or macOS moved the app to a random
# read-only path because the download quarantine was still on it ("App
# Translocation"), which Setup also cures by clearing that flag.
if [ ! -f "$MODULE" ] || [ ! -d "$ROOT/game" ]; then
    osascript -e 'display alert "Ring Out is not set up yet" message "Double-click Setup.command in the Ring Out folder first. It recompiles your disc for this Mac, once (about 10 minutes)." as critical' >/dev/null 2>&1
    exit 1
fi

mkdir -p "$ROOT/userdata"
exec "$APP/Contents/MacOS/moderngekko-run" --user-dir "$ROOT/userdata" \
    --game "$ROOT/game" --module "$MODULE" "$@" \
    >"$ROOT/userdata/${RINGOUT_LOG_NAME:-launch.log}" 2>&1
